  "properties": [
    {
      "identifier": "CellLocator",
      "name": "基站定位",
      "accessMode": "r",
      "desc": "使用移远云基站定位功能，每个token可以定位50000次。",
      "required": false,
      "dataType": {
        "type": "struct",
        "specs": [
          {
            "identifier": "Longitude",
            "name": "经度",
            "dataType": {
              "type": "double",
              "specs": {
                "min": "-180",
                "max": "180",
                "unit": "°",
                "unitName": "度",
                "step": "0.01"
              }
            }
          },
          {
            "identifier": "Latitude",
            "name": "维度",
