"""Structured runtimeLog/debugLog reporting with bounded local persistence."""

try:
    import ujson as json
except ImportError:
    import json

try:
    import uos as os
except ImportError:
    import os

try:
    import utime as time
except ImportError:
    import time

try:
    import _thread

    def new_lock():
        return _thread.allocate_lock()

except ImportError:
    import threading

    def new_lock():
        return threading.Lock()

from collector_config import LOCAL_LOG_DIR, LOCAL_LOG_MAX_BYTES, PROJECT_VERSION, ensure_dir


LEVEL_VALUES = {"DEBUG": 10, "INFO": 20, "WARN": 30, "ERROR": 40}
SECRET_MARKERS = (
    "deviceSecret",
    "productSecret",
    "password",
    "auth_key",
    "token",
    "clientSecret",
    "accessKeySecret",
)


def uptime_ms():
    try:
        return int(time.ticks_ms()) & 0x7FFFFFFF
    except Exception:
        return int(time.time() * 1000) & 0x7FFFFFFF


def _clip(value, length):
    value = str(value)
    if len(value) > length:
        return value[: length - 3] + "..."
    return value


def redact(text):
    text = str(text)
    for marker in SECRET_MARKERS:
        start = 0
        while True:
            index = text.lower().find(marker.lower(), start)
            if index < 0:
                break
            value_start = index + len(marker)
            while value_start < len(text) and text[value_start] in " \t:=\"'":
                value_start += 1
            value_end = value_start
            while value_end < len(text) and text[value_end] not in " ,}\"'\r\n":
                value_end += 1
            text = text[:value_start] + "***" + text[value_end:]
            start = value_start + 3
    return text


def model_int(value):
    try:
        value = int(value)
    except Exception:
        value = 0
    if value < 0:
        return 0
    if value > 0x7FFFFFFF:
        return 0x7FFFFFFF
    return value


class StructuredLogger:
    def __init__(self, local_dir=LOCAL_LOG_DIR, min_level="INFO"):
        self.local_dir = local_dir
        self.min_level = LEVEL_VALUES.get(min_level, 20)
        self.queue = []
        self.queue_max = 50
        self.lock = new_lock()
        self.state_lock = new_lock()
        self.file_lock = new_lock()
        self.sequence = 0
        self.publisher = None
        self.context_provider = None
        self.rate = {}
        self.dropped = 0
        self.paused = False
        ensure_dir(local_dir)

    def attach_cloud(self, publisher, context_provider=None):
        self.publisher = publisher
        self.context_provider = context_provider

    def _context(self):
        if not self.context_provider:
            return {}
        try:
            value = self.context_provider()
            return value if isinstance(value, dict) else {}
        except Exception:
            return {}

    def _next_sequence(self):
        self.state_lock.acquire()
        try:
            self.sequence = (self.sequence + 1) & 0x7FFFFFFF
            return self.sequence
        finally:
            self.state_lock.release()

    def _allow(self, key, interval_s):
        if not interval_s:
            return True
        now = int(time.time())
        self.state_lock.acquire()
        try:
            last = self.rate.get(key)
            if last is not None and now >= last and now - last < interval_s:
                return False
            self.rate[key] = now
            return True
        finally:
            self.state_lock.release()

    def _persist(self, event):
        self.file_lock.acquire()
        try:
            self._persist_locked(event)
        finally:
            self.file_lock.release()

    def clear_persistent(self):
        """Reclaim bounded local logs before a small-partition OTA."""
        self.file_lock.acquire()
        try:
            for name in ("critical.log", "critical.log.1"):
                try:
                    os.remove(self.local_dir + "/" + name)
                except Exception:
                    pass
        finally:
            self.file_lock.release()

    def _persist_locked(self, event):
        path = self.local_dir + "/critical.log"
        rotated = self.local_dir + "/critical.log.1"
        line = json.dumps(event) + "\n"
        try:
            line_size = len(line.encode("utf-8"))
        except Exception:
            line_size = len(line)
        try:
            size = os.stat(path)[6]
        except Exception:
            size = 0
        if size + line_size > LOCAL_LOG_MAX_BYTES:
            try:
                os.remove(rotated)
            except Exception:
                pass
            try:
                os.rename(path, rotated)
            except Exception:
                pass
        try:
            with open(path, "a") as stream:
                stream.write(line)
        except Exception:
            pass

    def _enqueue(self, identifier, payload):
        self.lock.acquire()
        try:
            if len(self.queue) >= self.queue_max:
                self.queue.pop(0)
                self.dropped += 1
            self.queue.append((identifier, payload))
        finally:
            self.lock.release()

    def debug_log(
        self, level, module, code, message, extra="", rate_limit_s=0
    ):
        level = str(level).upper()
        if LEVEL_VALUES.get(level, 20) < self.min_level:
            return False
        key = "{}:{}:{}".format(level, module, code)
        if not self._allow(key, rate_limit_s):
            return False
        context = self._context()
        payload = {
            "level": _clip(level, 8),
            "module": _clip(module, 32),
            "code": _clip(code, 48),
            "msg": _clip(redact(message), 512),
            "seq": self._next_sequence(),
            "version": PROJECT_VERSION,
            "boot_ms": uptime_ms(),
            "mqtt_state": _clip(context.get("mqtt_state", "unknown"), 32),
            "net_state": _clip(context.get("net_state", "unknown"), 64),
            "extra": _clip(redact(extra), 512),
        }
        try:
            print("[{}] {}:{} {}".format(level, module, code, payload["msg"]))
        except Exception:
            pass
        if level in ("WARN", "ERROR"):
            self._persist({"event": "debugLog", "params": payload})
        if not self.paused:
            self._enqueue("debugLog", payload)
        return True

    def runtime(
        self,
        category,
        target_type,
        target,
        action,
        source,
        description,
        value=0,
        temperature=0.0,
        humidity=0.0,
        extra="",
        rate_limit_s=0,
    ):
        key = "runtime:{}:{}:{}".format(category, target, action)
        if not self._allow(key, rate_limit_s):
            return False
        context = self._context()
        state_extra = "mqtt_state={},net_state={}".format(
            context.get("mqtt_state", "unknown"),
            context.get("net_state", "unknown"),
        )
        if extra:
            extra = state_extra + "," + str(extra)
        else:
            extra = state_extra
        payload = {
            "category": _clip(category, 32),
            "targetType": _clip(target_type, 32),
            "target": _clip(target, 32),
            "action": _clip(action, 16),
            "source": _clip(source, 16),
            "desc": _clip(redact(description), 256),
            "temperature": float(temperature),
            "humidity": float(humidity),
            # "value" is an Aliyun TSL reserved identifier. Keep the public
            # method argument for caller compatibility, but publish the
            # model-safe field name defined in doc/model.
            "metricValue": model_int(value),
            "seq": self._next_sequence(),
            "version": PROJECT_VERSION,
            "extra": _clip(redact(extra), 256),
        }
        try:
            print("[RUNTIME] {} {} {}".format(category, action, payload["desc"]))
        except Exception:
            pass
        if not self.paused:
            self._enqueue("runtimeLog", payload)
        return True

    def debug(self, module, code, message, extra=""):
        return self.debug_log("DEBUG", module, code, message, extra)

    def info(self, module, code, message, extra="", rate_limit_s=0):
        return self.debug_log(
            "INFO", module, code, message, extra, rate_limit_s=rate_limit_s
        )

    def warn(self, module, code, message, extra="", rate_limit_s=0):
        return self.debug_log(
            "WARN", module, code, message, extra, rate_limit_s=rate_limit_s
        )

    def error(self, module, code, message, extra="", rate_limit_s=0):
        return self.debug_log(
            "ERROR", module, code, message, extra, rate_limit_s=rate_limit_s
        )

    def flush_one(self):
        if not self.publisher or self.paused:
            return False
        self.lock.acquire()
        try:
            if not self.queue:
                return False
            item = self.queue[0]
        finally:
            self.lock.release()
        try:
            if not self.publisher(item[0], item[1]):
                return False
        except Exception:
            return False
        self.lock.acquire()
        try:
            if self.queue and self.queue[0] is item:
                self.queue.pop(0)
        finally:
            self.lock.release()
        return True

    def stats(self):
        self.lock.acquire()
        try:
            return {"queued": len(self.queue), "dropped": self.dropped}
        finally:
            self.lock.release()
