"""Aliyun application OTA for EC600M.

Two paths are supported:
* app_fota multi-file HTTP download with per-file MD5 verification;
* Aliyun MQTT 4096-byte block download for the legacy /usr/main.py package.
"""

try:
    import ujson as json
except ImportError:
    import json

try:
    import uos as os
except ImportError:
    import os

try:
    import ustruct as struct
except ImportError:
    import struct

try:
    import uhashlib as hashlib
except ImportError:
    import hashlib

try:
    import ubinascii as binascii
except ImportError:
    import binascii

try:
    import utime as time
except ImportError:
    import time

try:
    import _thread
except ImportError:
    _thread = None

from collector_config import (
    FILESYSTEM_SAFETY_BYTES,
    OTA_DIRECTORY_BYTES,
    OTA_HEALTH_OK_FILE,
    OTA_HEALTH_PENDING_FILE,
    OTA_MAX_APP_BYTES,
    OTA_MODULE_NAME,
    OTA_MULTI_FILE_TARGETS,
    OTA_UPDATER_DIR,
    PROJECT_VERSION,
    atomic_json_write,
    ensure_dir,
)
from collector_queue import file_size, remove_file


MQTT_BLOCK_SIZE = 4096
MQTT_REPLY_TIMEOUT_MS = 15000
MQTT_REQUEST_RETRIES = 3
MQTT_FILE_TOKEN = "collector_app"
MQTT_TEMP_FILE = "/usr/main.py.ota"
MQTT_TARGET_FILE = "/usr/main.py"
MQTT_BACKUP_FILE = "/usr/main.py.bak"

ROLLBACK_DIR = "/usr/.collector_rollback"
PROGRESS_MIN_INTERVAL_MS = 3000


def ticks_ms():
    try:
        return int(time.ticks_ms())
    except Exception:
        return int(time.time() * 1000)


def ticks_diff(now, then):
    try:
        return time.ticks_diff(now, then)
    except Exception:
        return now - then


def sleep_ms(value):
    try:
        time.sleep_ms(value)
    except Exception:
        time.sleep(float(value) / 1000.0)


def aligned_size(value, alignment=4096):
    value = int(value)
    return ((value + alignment - 1) // alignment) * alignment


def add_target_directories(directory_set, target):
    parent = str(target).rsplit("/", 1)[0]
    current = ""
    for part in parent.split("/"):
        if not part:
            continue
        current += "/" + part
        directory_set[current] = True


def version_parts(value):
    result = []
    for item in str(value).split("."):
        digits = ""
        for char in item:
            if "0" <= char <= "9":
                digits += char
            else:
                break
        result.append(int(digits or 0))
    while len(result) < 4:
        result.append(0)
    return result


def is_newer_version(candidate, current=PROJECT_VERSION):
    return version_parts(candidate) > version_parts(current)


def byte_value(data, index):
    value = data[index]
    return value if isinstance(value, int) else ord(value)


def crc16_ibm(data):
    crc = 0
    for value in data:
        if not isinstance(value, int):
            value = ord(value)
        crc ^= value
        for _ in range(8):
            crc = (crc >> 1) ^ (0xA001 if crc & 1 else 0)
    return crc & 0xFFFF


def calculate_md5(path):
    try:
        digest = hashlib.md5()
        with open(path, "rb") as stream:
            while True:
                data = stream.read(1024)
                if not data:
                    break
                digest.update(data)
        return binascii.hexlify(digest.digest()).decode().lower()
    except Exception:
        return ""


def is_md5(value):
    value = str(value).lower()
    if len(value) != 32:
        return False
    for char in value:
        if char not in "0123456789abcdef":
            return False
    return True


def validate_python_file(path):
    """Reject an invalid legacy bootstrap before replacing /usr/main.py."""
    try:
        with open(path, "rb") as stream:
            source = stream.read()
        try:
            source = source.decode("utf-8")
        except Exception:
            return False
        compile(source, path, "exec")
        return True
    except Exception:
        return False


def copy_file(source, target):
    ensure_dir(target.replace("\\", "/").rsplit("/", 1)[0])
    try:
        with open(source, "rb") as reader:
            with open(target, "wb") as writer:
                while True:
                    data = reader.read(1024)
                    if not data:
                        break
                    writer.write(data)
        return True
    except Exception:
        return False


def replace_from_backup(source, target):
    """Copy completely before swapping a rollback target into place."""
    temporary = target + ".rollback"
    remove_file(temporary)
    if not copy_file(source, temporary):
        remove_file(temporary)
        return False
    if file_size(temporary) != file_size(source):
        remove_file(temporary)
        return False
    remove_file(target)
    try:
        os.rename(temporary, target)
        return True
    except Exception:
        # Some firmware/filesystem combinations cannot rename over a recently
        # removed target. Keep the backup and fall back to a verified copy.
        restored = copy_file(source, target) and file_size(target) == file_size(source)
        if restored:
            remove_file(temporary)
        return restored


def remove_tree(path):
    try:
        entries = os.ilistdir(path)
    except Exception:
        try:
            entries = os.listdir(path)
            entries = [(name, 0x4000 if _is_dir(path + "/" + name) else 0) for name in entries]
        except Exception:
            return
    for entry in entries:
        name = entry[0]
        mode = entry[1] if len(entry) > 1 else 0
        child = path.rstrip("/") + "/" + name
        if mode & 0x4000:
            remove_tree(child)
            try:
                os.rmdir(child)
            except Exception:
                pass
        else:
            remove_file(child)
    try:
        os.rmdir(path)
    except Exception:
        # Some QuecPython firmware revisions are more reliable when hidden
        # app_fota trees are removed through ql_fs.
        try:
            import ql_fs

            ql_fs.rmdirs(path.lstrip("/"))
        except Exception:
            pass


def _is_dir(path):
    try:
        return bool(os.stat(path)[0] & 0x4000)
    except Exception:
        return False


def list_tree_files(path):
    """List staged files without depending on an app_fota layout version."""
    result = []
    pending = [path]
    while pending:
        directory = pending.pop()
        try:
            entries = os.ilistdir(directory)
        except Exception:
            try:
                entries = os.listdir(directory)
                entries = [(name, 0) for name in entries]
            except Exception:
                continue
        for entry in entries:
            name = entry[0] if isinstance(entry, tuple) else entry
            mode = entry[1] if isinstance(entry, tuple) and len(entry) > 1 else 0
            child = directory.rstrip("/") + "/" + name
            if mode & 0x4000 or (not mode and _is_dir(child)):
                pending.append(child)
            else:
                result.append(child)
    return result


def safe_target_path(path):
    path = str(path).replace("\\", "/")
    if not path.startswith("/usr/"):
        return False
    if ".." in path or "//" in path or path.endswith("/"):
        return False
    if path in ("/usr/device.json", "/usr/device_secret.json"):
        return False
    protected = (
        "/usr/config/",
        "/usr/data/",
        "/usr/log/",
        "/usr/.ota_",
        "/usr/.updater/",
        "/usr/.collector_rollback/",
    )
    for prefix in protected:
        if path.startswith(prefix):
            return False
    # Multi-file packages keep main.py stable so it can perform rollback.
    # A signed download is not permission to write an arbitrary /usr script:
    # targets must be one of the application modules shipped by this build.
    return path in OTA_MULTI_FILE_TARGETS


def url_host(url):
    text = str(url)
    marker = text.find("://")
    if marker < 0:
        return ""
    start = marker + 3
    end = len(text)
    for char in ("/", "?", "#"):
        index = text.find(char, start)
        if index >= 0 and index < end:
            end = index
    host_port = text[start:end].lower()
    if "@" in host_port:
        return ""
    return host_port.split(":", 1)[0]


def normalize_http_url(url, allowed_hosts):
    text = str(url).strip()
    host = url_host(text)
    if not host:
        raise ValueError("OTA URL missing host")
    allowed = False
    for suffix in allowed_hosts:
        suffix = str(suffix).lower()
        if suffix.startswith("."):
            if host.endswith(suffix) and host != suffix[1:]:
                allowed = True
                break
        elif host == suffix:
            allowed = True
            break
    if not allowed:
        raise ValueError("OTA URL host is not allowed")
    if text.startswith("https://"):
        text = "http://" + text[8:]
    if not text.startswith("http://"):
        raise ValueError("EC600M app OTA requires HTTP")
    return text


def parse_file_reply(payload):
    if payload is None or len(payload) < 4:
        return None
    json_length = (byte_value(payload, 0) << 8) | byte_value(payload, 1)
    json_end = 2 + json_length
    if json_length <= 0 or json_end > len(payload) - 2:
        return None
    try:
        meta = json.loads(payload[2:json_end].decode())
    except Exception:
        return None
    block = payload[json_end:-2]
    expected_crc = byte_value(payload, len(payload) - 2) | (
        byte_value(payload, len(payload) - 1) << 8
    )
    if crc16_ibm(block) != expected_crc:
        return None
    return {"id": str(meta.get("id", "")), "meta": meta, "block": block}


class OtaBootGuard:
    """Restores multi-file backups if a new application cannot become healthy."""

    @staticmethod
    def load_pending():
        best = None
        for path in (OTA_HEALTH_PENDING_FILE, OTA_HEALTH_PENDING_FILE + ".tmp"):
            try:
                with open(path, "r") as stream:
                    candidate = json.loads(stream.read())
                if best is None or int(candidate.get("attempts", 0)) > int(
                    best.get("attempts", 0)
                ):
                    best = candidate
            except Exception:
                pass
        return best

    @staticmethod
    def restore(pending=None):
        if pending is None:
            pending = OtaBootGuard.load_pending()
            if pending is None:
                return False
        restored = True
        for item in pending.get("backups", []):
            source = item.get("backup", "")
            target = item.get("target", "")
            if item.get("created"):
                if target and file_size(target) >= 0 and not remove_file(target):
                    restored = False
                continue
            if (
                not source
                or not target
                or file_size(source) < 0
                or not replace_from_backup(source, target)
            ):
                restored = False
        if restored:
            for item in pending.get("backups", []):
                remove_file(item.get("backup", ""))
            remove_file(OTA_HEALTH_PENDING_FILE)
            remove_file(OTA_HEALTH_PENDING_FILE + ".tmp")
            remove_file(OTA_HEALTH_OK_FILE)
            remove_tree(ROLLBACK_DIR)
        return restored

    @staticmethod
    def mark_healthy():
        try:
            with open(OTA_HEALTH_OK_FILE, "w") as stream:
                stream.write(PROJECT_VERSION)
            remove_file(OTA_HEALTH_PENDING_FILE)
            remove_file(OTA_HEALTH_PENDING_FILE + ".tmp")
            remove_file(MQTT_BACKUP_FILE)
            remove_tree(ROLLBACK_DIR)
            return True
        except Exception:
            return False


class OtaManager:
    def __init__(
        self,
        config,
        storage_budget,
        publish,
        logger,
        quiet_provider,
        reboot,
        id_provider=None,
        storage_prepare=None,
        storage_restore=None,
        activity_provider=None,
    ):
        self.config = config
        self.storage = storage_budget
        self.publish = publish
        self.logger = logger
        self.quiet_provider = quiet_provider
        self.reboot = reboot
        self.id_provider = id_provider
        self.storage_prepare = storage_prepare
        self.storage_restore = storage_restore
        self.activity_provider = activity_provider
        self.queue = []
        self.queue_lock = _thread.allocate_lock() if _thread else None
        self.id_lock = _thread.allocate_lock() if _thread else None
        self.running = False
        self.stop = False
        self.file_replies = []
        self.file_reply_lock = _thread.allocate_lock() if _thread else None
        self.last_progress_ms = None
        self.message_id = 0
        self.active_version = ""

    def _prepare_storage(self):
        if self.storage_prepare and not self.storage_prepare():
            raise OSError("runtime storage is not ready for OTA")

    def _restore_storage(self):
        if self.storage_restore:
            return self.storage_restore()
        return self.storage.restore_reserve()

    def _activity_marker(self):
        if not self.activity_provider:
            return None
        return self.activity_provider()

    def _ensure_activity_unchanged(self, marker):
        if self.activity_provider and self.activity_provider() != marker:
            raise OSError("UART activity resumed during OTA")

    def _next_id(self):
        if self.id_provider:
            return str(self.id_provider())
        if self.id_lock:
            self.id_lock.acquire()
        try:
            self.message_id = (self.message_id + 1) & 0x7FFFFFFF
            return str(self.message_id)
        finally:
            if self.id_lock:
                self.id_lock.release()

    def enqueue(self, data):
        if not isinstance(data, dict):
            return False
        self._usb_progress(0, "upgrade task received", data.get("version", ""))
        if self.queue_lock:
            self.queue_lock.acquire()
        try:
            if len(self.queue) >= 2:
                self.logger.warn("ota", "QUEUE_FULL", "OTA command queue is full")
                return False
            self.queue.append(data)
            return True
        finally:
            if self.queue_lock:
                self.queue_lock.release()

    def start(self):
        if _thread:
            _thread.start_new_thread(self.worker, ())

    def handle_file_reply(self, payload):
        reply = parse_file_reply(payload)
        if not reply:
            self.logger.error("ota", "BLOCK_REPLY", "Invalid MQTT OTA block reply")
            return
        if self.file_reply_lock:
            self.file_reply_lock.acquire()
        try:
            if len(self.file_replies) >= 4:
                self.file_replies.pop(0)
            self.file_replies.append(reply)
        finally:
            if self.file_reply_lock:
                self.file_reply_lock.release()

    def _wait_reply(self, request_id):
        started = ticks_ms()
        while ticks_diff(ticks_ms(), started) < MQTT_REPLY_TIMEOUT_MS:
            if self.file_reply_lock:
                self.file_reply_lock.acquire()
            try:
                for index, reply in enumerate(self.file_replies):
                    if reply["id"] == request_id:
                        return self.file_replies.pop(index)
            finally:
                if self.file_reply_lock:
                    self.file_reply_lock.release()
            sleep_ms(200)
        return None

    def report_version(self):
        payload = {
            "id": self._next_id(),
            "params": {"version": PROJECT_VERSION, "module": OTA_MODULE_NAME},
        }
        self.publish(self.config.ota_topic("inform"), json.dumps(payload), 1)

    def query_upgrade(self):
        payload = {
            "id": self._next_id(),
            "version": "1.0",
            "params": {"module": OTA_MODULE_NAME},
            "method": "thing.ota.firmware.get",
        }
        self.publish(
            self.config.topic("thing/ota/firmware/get"), json.dumps(payload), 1
        )

    def progress(self, step, description, force=False):
        self._usb_progress(step, description)
        now = ticks_ms()
        if self.last_progress_ms is not None:
            elapsed = ticks_diff(now, self.last_progress_ms)
            if elapsed < PROGRESS_MIN_INTERVAL_MS:
                if not force:
                    return False
                sleep_ms(PROGRESS_MIN_INTERVAL_MS - max(0, elapsed))
                now = ticks_ms()
        self.last_progress_ms = now
        payload = {
            "id": self._next_id(),
            "params": {
                # Aliyun OTA defines step as a numeric string, including
                # negative failure codes such as "-1".
                "step": str(int(step)),
                "desc": str(description)[:128],
                "module": OTA_MODULE_NAME,
            },
        }
        return self.publish(
            self.config.ota_topic("progress"), json.dumps(payload), 1
        )

    def _usb_progress(self, step, description, version=""):
        # Never print signed URLs or complete task payloads here. QPYcom adds
        # its own timestamp, so keep the device-side message compact.
        target_version = str(version or self.active_version or PROJECT_VERSION)
        try:
            print(
                "[OTA] version={} progress={}% {}".format(
                    target_version, int(step), str(description)[:128]
                )
            )
        except Exception:
            pass

    def worker(self):
        while not self.stop:
            if self.queue_lock:
                self.queue_lock.acquire()
            try:
                has_item = bool(self.queue)
            finally:
                if self.queue_lock:
                    self.queue_lock.release()
            if not has_item:
                sleep_ms(200)
                continue
            try:
                quiet_ready = self.quiet_provider()
            except Exception as error:
                self.logger.error(
                    "ota", "QUIET_GATE", "OTA quiet gate failed",
                    extra=str(error), rate_limit_s=10
                )
                sleep_ms(1000)
                continue
            if not quiet_ready:
                sleep_ms(1000)
                continue
            if self.queue_lock:
                self.queue_lock.acquire()
            try:
                data = self.queue.pop(0) if self.queue else None
            finally:
                if self.queue_lock:
                    self.queue_lock.release()
            if data is None:
                continue
            self.running = True
            self.active_version = str(data.get("version", ""))
            try:
                self.progress(1, "quiet window satisfied", force=True)
                self.process(data)
            except Exception as error:
                self.logger.error("ota", "PROCESS", "OTA failed: {}".format(error))
                self.progress(-1, "OTA failed: {}".format(error), force=True)
                remove_file(MQTT_TEMP_FILE)
                remove_tree(OTA_UPDATER_DIR)
                OtaBootGuard.restore()
                self._restore_storage()
            self.running = False
            self.active_version = ""

    def _package_info(self, data):
        ext_data = data.get("extData", {})
        if isinstance(ext_data, str):
            try:
                ext_data = json.loads(ext_data)
            except Exception:
                ext_data = {}
        if not isinstance(ext_data, dict):
            return {}
        package = ext_data.get("_package_udi", {})
        if isinstance(package, str):
            try:
                package = json.loads(package)
            except Exception:
                package = {}
        # The Aliyun console normally wraps the custom-information value in
        # _package_udi.  Tolerate an operator pasting a complete extData object
        # into that field, which produces one additional _package_udi layer.
        if isinstance(package, dict) and "_package_udi" in package:
            nested = package.get("_package_udi", {})
            if isinstance(nested, str):
                try:
                    nested = json.loads(nested)
                except Exception:
                    nested = {}
            if isinstance(nested, dict):
                package = nested
        return package if isinstance(package, dict) else {}

    def _package_mapping(self, data):
        package = self._package_info(data)
        mapping = package.get("files", {}) if isinstance(package, dict) else {}
        return mapping if isinstance(mapping, dict) else {}

    def _build_multi_files(self, data):
        files = data.get("files", [])
        mapping = self._package_mapping(data)
        if not isinstance(files, list) or not files:
            raise ValueError("OTA files list is empty")
        result = []
        total = 0
        directories = {}
        targets = {}
        for item in files:
            sign_method = str(
                item.get("signMethod", data.get("signMethod", ""))
            ).lower()
            if sign_method and sign_method != "md5":
                raise ValueError("unsupported OTA signature method")
            file_name = str(item.get("fileName", ""))
            target = mapping.get(file_name, "")
            if not safe_target_path(target):
                raise ValueError("unsafe or missing OTA target for {}".format(file_name))
            if target in targets:
                raise ValueError("duplicate OTA target: {}".format(target))
            targets[target] = True
            size = int(item.get("fileSize", item.get("size", 0)))
            md5 = str(
                item.get("fileMd5", item.get("sign", item.get("md5", "")))
            ).lower()
            if size <= 0 or not is_md5(md5):
                raise ValueError("incomplete OTA metadata for {}".format(file_name))
            total += aligned_size(size)
            add_target_directories(directories, target)
            result.append(
                {
                    "url": normalize_http_url(
                        item.get("fileUrl", ""), self.config.ota_allowed_hosts
                    ),
                    "file_name": target,
                    "size": size,
                    "md5": md5,
                }
            )
        total += len(directories) * OTA_DIRECTORY_BYTES
        if total > OTA_MAX_APP_BYTES:
            raise ValueError(
                "OTA package exceeds {} KiB application limit".format(
                    OTA_MAX_APP_BYTES // 1024
                )
            )
        return result, total

    def _staged_path(self, target):
        candidates = [
            OTA_UPDATER_DIR.rstrip("/") + target,
            OTA_UPDATER_DIR.rstrip("/") + "/" + target.rsplit("/", 1)[-1],
        ]
        for path in candidates:
            if file_size(path) >= 0:
                return path
        return ""

    def _backup_targets(self, files, version):
        remove_tree(ROLLBACK_DIR)
        ensure_dir(ROLLBACK_DIR)
        remove_file(OTA_HEALTH_OK_FILE)
        backups = []
        for index, item in enumerate(files):
            target = item["file_name"]
            if file_size(target) < 0:
                backups.append({"target": target, "created": True})
                continue
            backup = ROLLBACK_DIR + "/{}.bak".format(index)
            if not copy_file(target, backup):
                raise OSError("backup failed: {}".format(target))
            backups.append({"target": target, "backup": backup})
        atomic_json_write(
            OTA_HEALTH_PENDING_FILE,
            {"version": version, "attempts": 0, "backups": backups},
        )

    def _verify_staged(self, files):
        # Current EC600M firmware mirrors /usr below .updater, while older
        # app_fota builds used a flatter layout. Prefer the target-associated
        # path; if the firmware uses another private layout, match every file
        # exactly once within the freshly cleared staging tree.
        catalog = []
        for path in list_tree_files(OTA_UPDATER_DIR):
            size = file_size(path)
            if size > 0:
                catalog.append(
                    {"path": path, "size": size, "md5": calculate_md5(path)}
                )
        used = {}
        for index, item in enumerate(files):
            path = self._staged_path(item["file_name"])
            if path:
                if file_size(path) != item["size"]:
                    return False, "size mismatch: {}".format(item["file_name"])
                digest = calculate_md5(path)
                if not digest or digest != item["md5"]:
                    return False, "MD5 mismatch: {}".format(item["file_name"])
                used[path] = True
                step = 90 + (5 * (index + 1) // len(files))
                self.progress(
                    step,
                    "MD5 verified {}/{}".format(index + 1, len(files)),
                )
                continue
            matched = None
            for candidate in catalog:
                if candidate["path"] in used:
                    continue
                if (
                    candidate["size"] == item["size"]
                    and candidate["md5"] == item["md5"]
                ):
                    matched = candidate["path"]
                    break
            if not matched:
                return False, "staged file missing or invalid: {}".format(
                    item["file_name"]
                )
            used[matched] = True
            step = 90 + (5 * (index + 1) // len(files))
            self.progress(
                step,
                "MD5 verified {}/{}".format(index + 1, len(files)),
            )
        return True, ""

    def _process_multi(self, data, version):
        files, total = self._build_multi_files(data)
        activity_marker = self._activity_marker()
        try:
            self._prepare_storage()
            ota_free = self.storage.ota_free_bytes()
            # app_fota staging and rollback copies coexist. Existing targets may
            # be larger than their replacements, so calculate their actual size.
            backup_total = OTA_DIRECTORY_BYTES
            copy_mode_extra = 0
            for item in files:
                current_size = file_size(item["file_name"])
                if current_size > 0:
                    backup_total += aligned_size(current_size)
                else:
                    # Older app_fota builds may not support rename mode. Their
                    # default copy mode needs a second allocation for new targets.
                    copy_mode_extra += aligned_size(item["size"])
            required = (
                total
                + backup_total
                + copy_mode_extra
                + FILESYSTEM_SAFETY_BYTES
                + 20 * 1024
            )
            if ota_free < required:
                raise OSError(
                    "insufficient OTA space: need={}, free={}".format(
                        required, ota_free
                    )
                )
            self.progress(
                5,
                "space and target checks passed: need={},free={}".format(
                    required, ota_free
                ),
                force=True,
            )
            remove_tree(OTA_UPDATER_DIR)
            if _is_dir(OTA_UPDATER_DIR):
                raise OSError("cannot clear stale app_fota staging directory")
            if not self.storage.release_reserve():
                raise OSError("cannot release OTA reserve")
            self._backup_targets(files, version)
            import app_fota

            updater = app_fota.new()
            download_list = []
            for item in files:
                download_list.append(
                    {"url": item["url"], "file_name": item["file_name"]}
                )
            self.progress(10, "multi-file download started", force=True)
            failures = updater.bulk_download(download_list)
            if failures:
                raise OSError("app_fota download failed: {}".format(failures))
            self.progress(85, "multi-file download completed", force=True)
            valid, reason = self._verify_staged(files)
            if not valid:
                raise ValueError(reason)
            self._ensure_activity_unchanged(activity_marker)
            try:
                flag_result = updater.set_update_flag(use_rename=True)
            except TypeError:
                flag_result = updater.set_update_flag()
            if flag_result not in (None, 0, True):
                raise OSError("set_update_flag failed: {}".format(flag_result))
            self.progress(99, "update flag set", force=True)
            self.progress(100, "preparing reboot", force=True)
        except Exception:
            remove_tree(OTA_UPDATER_DIR)
            OtaBootGuard.restore()
            self._restore_storage()
            raise
        sleep_ms(100)
        self.reboot()

    def _build_single_task(self, data, version):
        protocol = str(data.get("dProtocol", data.get("protocol", ""))).lower()
        if protocol and protocol != "mqtt":
            raise ValueError("legacy single-file OTA requires MQTT")
        sign_method = str(data.get("signMethod", "")).lower()
        if sign_method and sign_method != "md5":
            raise ValueError("unsupported legacy OTA signature method")
        package = self._package_info(data)
        if package and package.get("target") != MQTT_TARGET_FILE:
            raise ValueError("legacy OTA target must be /usr/main.py")
        size = int(data.get("size", 0))
        md5 = str(data.get("sign", data.get("md5", ""))).lower()
        stream_id = data.get("streamId", "")
        file_id = data.get("streamFileId", data.get("fileId", ""))
        if size <= 0 or size > OTA_MAX_APP_BYTES:
            raise ValueError("invalid legacy OTA size")
        if not is_md5(md5) or not str(stream_id) or not str(file_id):
            raise ValueError("incomplete legacy OTA metadata")
        return {
            "version": version,
            "size": size,
            "md5": md5,
            "stream_id": stream_id,
            "file_id": file_id,
        }

    def _request_block(self, task, offset, size):
        request_id = self._next_id()
        payload = {
            "id": request_id,
            "version": "1.0",
            "params": {
                "fileToken": MQTT_FILE_TOKEN,
                "fileInfo": {
                    "streamId": task["stream_id"],
                    "fileId": task["file_id"],
                },
                "fileBlock": {"size": size, "offset": offset},
            },
        }
        if not self.publish(
            self.config.topic("thing/file/download"), json.dumps(payload), 0
        ):
            return None
        return request_id

    def _download_single(self, task):
        remove_file(MQTT_TEMP_FILE)
        offset = 0
        with open(MQTT_TEMP_FILE, "wb") as stream:
            while offset < task["size"]:
                block_size = min(MQTT_BLOCK_SIZE, task["size"] - offset)
                accepted = False
                for _ in range(MQTT_REQUEST_RETRIES):
                    request_id = self._request_block(task, offset, block_size)
                    reply = self._wait_reply(request_id) if request_id else None
                    if not reply:
                        continue
                    meta = reply["meta"]
                    if str(meta.get("code", "")) not in ("0", "200"):
                        continue
                    details = meta.get("data", {})
                    block = reply["block"]
                    file_token = str(details.get("fileToken", ""))
                    if file_token and file_token != MQTT_FILE_TOKEN:
                        continue
                    try:
                        total_size = int(details.get("fileLength", task["size"]))
                        reply_offset = int(
                            details.get("bOffset", details.get("offset", -1))
                        )
                        reply_size = int(
                            details.get("bSize", details.get("size", -1))
                        )
                    except Exception:
                        continue
                    if total_size != task["size"]:
                        continue
                    if reply_offset != offset:
                        continue
                    if reply_size != len(block):
                        continue
                    if len(block) != block_size:
                        continue
                    stream.write(block)
                    offset += len(block)
                    accepted = True
                    break
                if not accepted:
                    return False
        return offset == task["size"]

    def _install_single(self, task):
        if file_size(MQTT_TEMP_FILE) != task["size"]:
            return False
        if calculate_md5(MQTT_TEMP_FILE) != task["md5"]:
            return False
        if not validate_python_file(MQTT_TEMP_FILE):
            return False
        remove_file(MQTT_BACKUP_FILE)
        if not copy_file(MQTT_TARGET_FILE, MQTT_BACKUP_FILE):
            return False
        if file_size(MQTT_BACKUP_FILE) != file_size(MQTT_TARGET_FILE):
            remove_file(MQTT_BACKUP_FILE)
            return False
        try:
            remove_file(OTA_HEALTH_OK_FILE)
            atomic_json_write(
                OTA_HEALTH_PENDING_FILE,
                {
                    "version": task["version"],
                    "attempts": 0,
                    "backups": [
                        {"target": MQTT_TARGET_FILE, "backup": MQTT_BACKUP_FILE}
                    ],
                },
            )
            # Try an atomic same-filesystem replacement first. Firmware that
            # does not replace an existing target falls back to a verified
            # copy-and-rename while the durable backup remains untouched.
            try:
                os.rename(MQTT_TEMP_FILE, MQTT_TARGET_FILE)
            except Exception:
                if not replace_from_backup(MQTT_TEMP_FILE, MQTT_TARGET_FILE):
                    raise OSError("legacy target replacement failed")
            if file_size(MQTT_TARGET_FILE) != task["size"]:
                raise OSError("legacy installed size mismatch")
            if calculate_md5(MQTT_TARGET_FILE) != task["md5"]:
                raise OSError("legacy installed MD5 mismatch")
            remove_file(MQTT_TEMP_FILE)
            return True
        except Exception:
            OtaBootGuard.restore()
            return False

    def _process_single(self, data, version):
        task = self._build_single_task(data, version)
        activity_marker = self._activity_marker()
        try:
            self._prepare_storage()
            current_size = file_size(MQTT_TARGET_FILE)
            if current_size <= 0:
                current_size = task["size"]
            required = (
                aligned_size(task["size"]) * 2
                + aligned_size(current_size)
                + OTA_DIRECTORY_BYTES
                + FILESYSTEM_SAFETY_BYTES
            )
            if self.storage.ota_free_bytes() < required:
                raise OSError("insufficient legacy OTA space")
            self.progress(
                5,
                "space and target checks passed: need={},free={}".format(
                    required, self.storage.ota_free_bytes()
                ),
                force=True,
            )
            if not self.storage.release_reserve():
                raise OSError("cannot release OTA reserve")
            self.progress(10, "MQTT download started", force=True)
            if not self._download_single(task):
                raise OSError("MQTT OTA download failed")
            self.progress(85, "MQTT download completed", force=True)
            self.progress(95, "legacy OTA verified", force=True)
            self._ensure_activity_unchanged(activity_marker)
            if not self._install_single(task):
                raise OSError("MQTT OTA verify/install failed")
            self.progress(99, "legacy update installed", force=True)
            self.progress(100, "preparing reboot", force=True)
        except Exception:
            remove_file(MQTT_TEMP_FILE)
            OtaBootGuard.restore()
            self._restore_storage()
            raise
        sleep_ms(100)
        self.reboot()

    def process(self, data):
        module = str(data.get("module", ""))
        if module != OTA_MODULE_NAME:
            self.logger.info("ota", "MODULE", "Ignore OTA module {}".format(module))
            return
        version = str(data.get("version", ""))
        if not is_newer_version(version):
            self.logger.info("ota", "VERSION", "Ignore OTA version {}".format(version))
            return
        self.logger.paused = True
        try:
            if data.get("files"):
                self._process_multi(data, version)
            else:
                self._process_single(data, version)
        finally:
            self.logger.paused = False
