"""Aliyun authentication, resilient MQTT state machine, and ACK delivery."""

try:
    import ujson as json
except ImportError:
    import json

try:
    import uhashlib as hashlib
except ImportError:
    import hashlib

try:
    import ubinascii as binascii
except ImportError:
    import binascii

try:
    import utime as time
except ImportError:
    import time

try:
    import _thread
except ImportError:
    _thread = None

from collector_config import (
    ACK_RETRY_LIMIT,
    ACK_TIMEOUT_MS,
    ALIYUN_SIGN_METHOD,
    DYNAMIC_REGISTER_POLL_MS,
    DYNAMIC_REGISTER_TIMEOUT_MS,
    DYNAMIC_REGISTER_TOPIC,
    INFLIGHT_LIMIT,
    MQTT_KEEPALIVE,
    PROJECT_NAME,
    PROJECT_VERSION,
    SIGNS_MQTT_QOS,
    SIGNS_PUBLISH_INTERVAL_MS,
    clear_cached_device_secret,
    load_cached_device_secret,
    save_cached_device_secret,
)
from collector_protocol import decode_signs_frame


def ticks_ms():
    try:
        return int(time.ticks_ms())
    except Exception:
        return int(time.time() * 1000)


def ticks_diff(now, then):
    try:
        return time.ticks_diff(now, then)
    except Exception:
        return now - then


def sleep_ms(value):
    try:
        time.sleep_ms(value)
    except Exception:
        time.sleep(float(value) / 1000.0)


def to_bytes(value):
    return value if isinstance(value, bytes) else str(value).encode("utf-8")


def hmac_sha256_hex(secret, content):
    block_size = 64
    key = to_bytes(secret)
    if len(key) > block_size:
        digest = hashlib.sha256()
        digest.update(key)
        key = digest.digest()
    # EC600M R06A06M08 exposes a bytearray implementation that can reject
    # item/slice assignment. Authentication is low-frequency, so construct
    # immutable pads directly instead of mutating preallocated bytearrays.
    key_block = key + (b"\x00" * (block_size - len(key)))
    inner_pad = bytes([value ^ 0x36 for value in key_block])
    outer_pad = bytes([value ^ 0x5C for value in key_block])
    inner = hashlib.sha256()
    inner.update(inner_pad)
    inner.update(to_bytes(content))
    outer = hashlib.sha256()
    outer.update(outer_pad)
    outer.update(inner.digest())
    return binascii.hexlify(outer.digest()).decode().lower()


def extract_device_secret(payload):
    try:
        data = json.loads(payload)
    except Exception:
        return ""
    secret = data.get("deviceSecret", "")
    nested = data.get("data", {})
    if not secret and isinstance(nested, dict):
        secret = nested.get("deviceSecret", "")
    return str(secret)


def _noop_log_basic_config(*_args, **_kwargs):
    """Compatibility shim for EC600M firmware with a reduced log module."""
    return None


class _SilentMqttLogger:
    def info(self, *_args, **_kwargs):
        return None

    warning = info
    error = info
    debug = info


_SILENT_MQTT_LOGGER = _SilentMqttLogger()


def _get_silent_mqtt_logger(*_args, **_kwargs):
    return _SILENT_MQTT_LOGGER


def _load_mqtt_client():
    """Load QuecPython umqtt after repairing known EC600M compatibility gaps."""
    try:
        import log
    except ImportError:
        log = None
    if log is not None:
        compatibility = (
            ("INFO", 20),
            ("basicConfig", _noop_log_basic_config),
            ("getLogger", _get_silent_mqtt_logger),
        )
        for name, value in compatibility:
            if hasattr(log, name):
                continue
            try:
                setattr(log, name, value)
            except Exception as error:
                raise ImportError(
                    "firmware log module has no mutable {}: {}".format(name, error)
                )

    # A failed import can leave a half-initialized module cached. Remove only
    # that invalid entry so reconnect attempts can import MQTTClient cleanly.
    try:
        import sys

        cached = sys.modules.get("umqtt")
        if cached is not None and not hasattr(cached, "MQTTClient"):
            del sys.modules["umqtt"]
    except Exception:
        pass

    from umqtt import MQTTClient

    return MQTTClient


class CloudClient:
    def __init__(self, config, delivery, logger):
        self.config = config
        self.delivery = delivery
        self.logger = logger
        self.ota = None
        self.client = None
        self.connected = False
        self.connecting = False
        self.stop = False
        self.connection_generation = 0
        self.publish_lock = _thread.allocate_lock() if _thread else None
        self.state_lock = _thread.allocate_lock() if _thread else None
        self.deferred_lock = _thread.allocate_lock() if _thread else None
        self.inflight = {}
        self.deferred_properties = []
        self.deferred_limit = 32
        self.deferred_dropped = 0
        self.retry_count = 0
        self.post_reply_success = 0
        self.post_reply_rejected = 0
        self.post_reply_unmatched = 0
        self.last_post_reply_code = 0
        self.last_signs_publish_ms = None
        self.last_connect_ms = 0
        self.connect_failures = 0
        self.force_dynamic_register = False
        self.checknet = None
        self.net_state = "unknown"
        self.net_stagecode = 0
        self.net_subcode = 0
        self.mqtt_state = "disconnected"
        self.topics = {
            "property_set": config.topic("thing/service/property/set"),
            "property_set_reply": config.topic("thing/service/property/set_reply"),
            "property_post": config.topic("thing/event/property/post"),
            "property_post_reply": config.topic("thing/event/property/post_reply"),
            "ota_upgrade": config.ota_topic("upgrade"),
            "ota_get_reply": config.topic("thing/ota/firmware/get_reply"),
            "ota_file_reply": config.topic("thing/file/download_reply"),
        }

    def attach_ota(self, ota):
        self.ota = ota

    def context(self):
        return {"mqtt_state": self.mqtt_state, "net_state": self.net_state}

    def next_message_id(self):
        # Alink requires a decimal id in the uint32 range. All application
        # message classes share the durable sequence allocator to avoid
        # collisions; the full sequence remains 64-bit in the local queue.
        return str(self.delivery.sequence.next() & 0xFFFFFFFF)

    def _network_ready(self):
        try:
            if self.checknet is None:
                import checkNet

                self.checknet = checkNet.CheckNetwork(PROJECT_NAME, PROJECT_VERSION)
                try:
                    self.checknet.poweron_print_once()
                except Exception:
                    pass
            stage, subcode = self.checknet.wait_network_connected(1)
            self.net_stagecode = int(stage)
            self.net_subcode = int(subcode)
            self.net_state = "stage={},subcode={}".format(stage, subcode)
            return stage == 3 and subcode == 1
        except Exception:
            pass
        try:
            import net
            import dataCall

            state = net.getState()
            registered = state != -1 and state[1][0] == 1
            call = dataCall.getInfo(1, 0)
            active = call != -1 and call[2][0] == 1
            if active:
                self.net_stagecode = 3
                self.net_subcode = 1
            elif registered:
                self.net_stagecode = 3
                self.net_subcode = 0
            else:
                self.net_stagecode = 2
                self.net_subcode = 0
            self.net_state = "registered={},pdp={}".format(
                1 if registered else 0, 1 if active else 0
            )
            return registered and active
        except Exception:
            self.net_state = "unknown"
            self.net_stagecode = 0
            self.net_subcode = 0
            return True

    def _network_status_value(self):
        return {
            "product_information:StageCode": {"value": self.net_stagecode},
            "product_information:SubCode": {"value": self.net_subcode},
        }

    def _base_client_id(self):
        return "{}.{}".format(self.config.product_key, self.config.device_name)

    def _username(self):
        return "{}&{}".format(self.config.device_name, self.config.product_key)

    def _timestamp(self):
        try:
            return str(int(time.time() * 1000))
        except Exception:
            return str(ticks_ms())

    def _device_auth(self, secret):
        timestamp = self._timestamp()
        base = self._base_client_id()
        content = "clientId{}deviceName{}productKey{}timestamp{}".format(
            base, self.config.device_name, self.config.product_key, timestamp
        )
        return {
            "client_id": "{}|securemode=2,signmethod={},timestamp={}|".format(
                base, ALIYUN_SIGN_METHOD, timestamp
            ),
            "username": self._username(),
            "password": hmac_sha256_hex(secret, content),
        }

    def _dynamic_register(self):
        if not self.config.product_secret:
            return ""
        MQTTClient = _load_mqtt_client()

        random_value = "{}{}".format(self._timestamp(), ticks_ms() & 0xFFFF)
        content = "deviceName{}productKey{}random{}".format(
            self.config.device_name, self.config.product_key, random_value
        )
        password = hmac_sha256_hex(self.config.product_secret, content)
        client_id = "{}|securemode=2,authType=register,random={},signmethod={}|".format(
            self._base_client_id(), random_value, ALIYUN_SIGN_METHOD
        )
        state = {"secret": ""}

        def callback(topic, message):
            topic_text = topic.decode() if isinstance(topic, bytes) else str(topic)
            if topic_text == DYNAMIC_REGISTER_TOPIC:
                state["secret"] = extract_device_secret(
                    message.decode() if isinstance(message, bytes) else message
                )

        register_client = MQTTClient(
            client_id,
            self.config.mqtt_server,
            8883,
            self._username(),
            password,
            keepalive=0,
            ssl=True,
            ssl_params={},
            reconn=False,
        )
        register_client.set_callback(callback)
        try:
            register_client.connect(clean_session=True)
            listen_state = {"stop": False, "error": None}

            def register_listener():
                try:
                    while not listen_state["stop"] and not state["secret"]:
                        register_client.wait_msg()
                except Exception as error:
                    listen_state["error"] = error

            if _thread:
                _thread.start_new_thread(register_listener, ())
            started = ticks_ms()
            while ticks_diff(ticks_ms(), started) < DYNAMIC_REGISTER_TIMEOUT_MS:
                if state["secret"]:
                    break
                if listen_state["error"]:
                    break
                sleep_ms(DYNAMIC_REGISTER_POLL_MS)
            listen_state["stop"] = True
        finally:
            try:
                register_client.disconnect()
            except Exception:
                try:
                    register_client.close()
                except Exception:
                    pass
        if state["secret"]:
            save_cached_device_secret(self.config, state["secret"])
        return state["secret"]

    def _get_device_secret(self):
        if self.config.device_secret:
            return self.config.device_secret
        if not self.force_dynamic_register:
            cached = load_cached_device_secret(self.config)
            if cached:
                return cached
        secret = self._dynamic_register()
        if secret:
            self.force_dynamic_register = False
        return secret

    def _mqtt_error(self, error):
        self.logger.warn(
            "mqtt", "CLIENT_ERROR", "MQTT client error: {}".format(error), rate_limit_s=10
        )
        self._mark_disconnected()

    def _connect_once(self):
        MQTTClient = _load_mqtt_client()

        secret = self._get_device_secret()
        if not secret:
            raise ValueError("DeviceSecret unavailable")
        auth = self._device_auth(secret)
        client = MQTTClient(
            auth["client_id"],
            self.config.mqtt_server,
            self.config.mqtt_port,
            auth["username"],
            auth["password"],
            keepalive=MQTT_KEEPALIVE,
            ssl=False,
            ssl_params={},
            reconn=False,
        )
        client.set_callback(self._message_callback)
        try:
            client.error_register_cb(self._mqtt_error)
        except Exception:
            pass
        try:
            client.connect(clean_session=False)
            subscriptions = (
                self.topics["property_set"],
                self.topics["property_post_reply"],
                self.topics["ota_upgrade"],
                self.topics["ota_get_reply"],
                self.topics["ota_file_reply"],
            )
            for topic in subscriptions:
                client.subscribe(topic.encode("utf-8"), 1)
        except Exception:
            try:
                client.close()
            except Exception:
                pass
            raise
        self.client = client
        self.connected = True
        self.mqtt_state = "connected"
        self.last_connect_ms = ticks_ms()
        self.connect_failures = 0
        self.connection_generation += 1
        self.logger.runtime(
            "network", "collector", self.config.device_name, "connect", "device",
            "Aliyun MQTT connected", value=1
        )
        self.publish_properties(
            {
                "product_information:AppVersion": PROJECT_VERSION,
                "product_information:NetStatus": self._network_status_value(),
            }
        )
        if self.ota:
            self.ota.report_version()
            self.ota.query_upgrade()
        generation = self.connection_generation
        if _thread:
            _thread.start_new_thread(self._listen_worker, (generation,))

    def _close_client(self):
        client = self.client
        self.client = None
        if client:
            try:
                client.close()
            except Exception:
                pass

    def _mark_disconnected(self):
        if self.state_lock:
            self.state_lock.acquire()
        try:
            if not self.connected and self.client is None:
                return
            self.connected = False
            self.mqtt_state = "disconnected"
            pending = list(self.inflight.values())
            self.inflight = {}
        finally:
            if self.state_lock:
                self.state_lock.release()
        self._close_client()
        for item in pending:
            self.delivery.release(item["seq"], item["source"])
        self.delivery.release_all()

    def _listen_worker(self, generation):
        while not self.stop and self.connected and generation == self.connection_generation:
            client = self.client
            if not client:
                break
            try:
                client.wait_msg()
            except Exception as error:
                self.logger.warn(
                    "mqtt", "LISTEN", "MQTT listener stopped: {}".format(error),
                    rate_limit_s=10
                )
                self._mark_disconnected()
                break

    def start(self):
        if not _thread:
            return
        _thread.start_new_thread(self._connection_worker, ())
        _thread.start_new_thread(self._delivery_worker, ())

    def _connection_worker(self):
        backoff = 2
        while not self.stop:
            if self.connected:
                sleep_ms(1000)
                continue
            if not self._network_ready():
                sleep_ms(2000)
                continue
            self.connecting = True
            self.mqtt_state = "connecting"
            try:
                self._connect_once()
                backoff = 2
            except Exception as error:
                self.connect_failures += 1
                if (
                    self.connect_failures >= 3
                    and not self.config.device_secret
                    and self.config.product_secret
                ):
                    clear_cached_device_secret()
                    self.force_dynamic_register = True
                    self.connect_failures = 0
                    self.logger.warn(
                        "mqtt", "AUTH_REFRESH",
                        "Refreshing dynamically registered DeviceSecret",
                        rate_limit_s=60,
                    )
                self.mqtt_state = "connect_failed"
                self.logger.error(
                    "mqtt", "CONNECT", "MQTT connect failed: {}".format(error),
                    rate_limit_s=10
                )
                self._mark_disconnected()
                sleep_ms(backoff * 1000)
                backoff = min(backoff * 2, 300)
            self.connecting = False

    def publish_raw(self, topic, payload, qos=0):
        if not self.connected or not self.client:
            return False
        if isinstance(topic, str):
            topic = topic.encode("utf-8")
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        if self.publish_lock:
            self.publish_lock.acquire()
        try:
            self.client.publish(topic, payload, qos=qos)
            return True
        except Exception as error:
            self.logger.warn(
                "mqtt", "PUBLISH", "MQTT publish failed: {}".format(error),
                rate_limit_s=10
            )
            self._mark_disconnected()
            return False
        finally:
            if self.publish_lock:
                self.publish_lock.release()

    def publish_properties(self, values, qos=0):
        params = {}
        for key, value in values.items():
            if isinstance(value, dict):
                params[key] = value
            else:
                params[key] = {"value": value}
        payload = {
            "id": self.next_message_id(),
            "version": "1.0",
            "params": params,
            "method": "thing.event.property.post",
        }
        return self.publish_raw(
            self.topics["property_post"], json.dumps(payload), qos
        )

    def defer_properties(self, values):
        """Queue UART-derived auxiliary properties for the cloud worker."""
        if not isinstance(values, dict) or not values:
            return False
        if self.deferred_lock:
            self.deferred_lock.acquire()
        try:
            if len(self.deferred_properties) >= self.deferred_limit:
                self.deferred_properties.pop(0)
                self.deferred_dropped += 1
            self.deferred_properties.append(values)
            return True
        finally:
            if self.deferred_lock:
                self.deferred_lock.release()

    def _flush_deferred_one(self):
        if self.deferred_lock:
            self.deferred_lock.acquire()
        try:
            item = self.deferred_properties[0] if self.deferred_properties else None
        finally:
            if self.deferred_lock:
                self.deferred_lock.release()
        if item is None:
            return False
        if not self.publish_properties(item):
            return False
        if self.deferred_lock:
            self.deferred_lock.acquire()
        try:
            if self.deferred_properties and self.deferred_properties[0] is item:
                self.deferred_properties.pop(0)
        finally:
            if self.deferred_lock:
                self.deferred_lock.release()
        return True

    def publish_event(self, identifier, params):
        try:
            event_time = int(time.time() * 1000)
        except Exception:
            event_time = ticks_ms()
        payload = {
            "id": self.next_message_id(),
            "version": "1.0",
            "params": {"value": params, "time": event_time},
            "method": "thing.event.{}.post".format(identifier),
        }
        return self.publish_raw(
            self.config.topic("thing/event/{}/post".format(identifier)),
            json.dumps(payload),
            0,
        )

    def _signs_payload(self, record):
        message_id = str(record["seq"] & 0xFFFFFFFF)
        payload = {
            "id": message_id,
            "version": "1.0",
            "params": {
                "collar_information:SignsData": decode_signs_frame(
                    record["frame"], record["timestamp_ms"]
                )
            },
            "method": "thing.event.property.post",
        }
        return message_id, json.dumps(payload)

    def _send_record(self, record, retry=0, payload=None):
        message_id = str(record["seq"] & 0xFFFFFFFF)
        if payload is None:
            message_id, payload = self._signs_payload(record)
        item = {
            "seq": record["seq"],
            "source": record["source"],
            "frame": record["frame"],
            "timestamp_ms": record["timestamp_ms"],
            "payload": payload,
            "sent_ms": ticks_ms(),
            "retries": retry,
        }
        if self.state_lock:
            self.state_lock.acquire()
        try:
            self.inflight[message_id] = item
        finally:
            if self.state_lock:
                self.state_lock.release()
        if not self.publish_raw(
            self.topics["property_post"], payload, SIGNS_MQTT_QOS
        ):
            if self.state_lock:
                self.state_lock.acquire()
            try:
                if self.inflight.get(message_id) is item:
                    del self.inflight[message_id]
            finally:
                if self.state_lock:
                    self.state_lock.release()
            self.delivery.release(record["seq"], record["source"])
            return False
        self.last_signs_publish_ms = ticks_ms()
        return True

    def _check_timeouts(self):
        now = ticks_ms()
        if self.state_lock:
            self.state_lock.acquire()
        try:
            snapshot = list(self.inflight.items())
        finally:
            if self.state_lock:
                self.state_lock.release()
        for message_id, item in snapshot:
            if ticks_diff(now, item["sent_ms"]) < ACK_TIMEOUT_MS:
                continue
            if item["retries"] >= ACK_RETRY_LIMIT:
                self.logger.warn(
                    "mqtt", "ACK_TIMEOUT",
                    "SignsData ACK retries exhausted; reconnecting",
                    extra="id={}".format(message_id), rate_limit_s=10
                )
                self._mark_disconnected()
                return
            record = {
                "seq": item["seq"],
                "source": item["source"],
                "frame": item["frame"],
                "timestamp_ms": item["timestamp_ms"],
            }
            retry = item["retries"] + 1
            if self.state_lock:
                self.state_lock.acquire()
            try:
                if self.inflight.get(message_id) is not item:
                    continue
                del self.inflight[message_id]
            finally:
                if self.state_lock:
                    self.state_lock.release()
            if self._send_record(record, retry=retry, payload=item["payload"]):
                self.retry_count += 1

    def _delivery_worker(self):
        while not self.stop:
            try:
                self._delivery_cycle()
            except Exception as error:
                self.logger.error(
                    "mqtt", "DELIVERY", "Delivery worker recovered",
                    extra=str(error), rate_limit_s=10
                )
                self._mark_disconnected()
            sleep_ms(20)

    def _delivery_cycle(self):
        if not self.connected:
            sleep_ms(100)
            return
        self._check_timeouts()
        if not self.connected:
            return
        while self.connected:
            now = ticks_ms()
            if (
                self.last_signs_publish_ms is not None
                and ticks_diff(now, self.last_signs_publish_ms)
                < SIGNS_PUBLISH_INTERVAL_MS
            ):
                break
            if self.state_lock:
                self.state_lock.acquire()
            try:
                inflight_count = len(self.inflight)
                inflight_values = list(self.inflight.values())
            finally:
                if self.state_lock:
                    self.state_lock.release()
            if inflight_count >= INFLIGHT_LIMIT:
                break
            excluded = {}
            for item in inflight_values:
                if item["source"] == "flash":
                    excluded[item["seq"]] = True
            record = self.delivery.next_record(excluded)
            if not record:
                break
            if not self._send_record(record):
                break
        if self.connected:
            self._flush_deferred_one()

    def _handle_property_reply(self, message):
        message_id = str(message.get("id", ""))
        if self.state_lock:
            self.state_lock.acquire()
        try:
            item = self.inflight.get(message_id)
        finally:
            if self.state_lock:
                self.state_lock.release()
        if not item:
            self.post_reply_unmatched += 1
            return
        try:
            code = int(message.get("code", -1))
        except Exception:
            code = -1
        self.last_post_reply_code = code
        reply_data = message.get("data", {})
        field_errors = bool(reply_data)
        if code != 200 or field_errors:
            self.post_reply_rejected += 1
            self.logger.warn(
                "mqtt", "POST_REPLY", "Aliyun rejected SignsData",
                extra="id={},code={},message={},data={}".format(
                    message_id,
                    code,
                    message.get("message", ""),
                    reply_data,
                ),
                rate_limit_s=5,
            )
            return
        if self.delivery.acknowledge(item["seq"], item["source"]):
            self.post_reply_success += 1
            if self.state_lock:
                self.state_lock.acquire()
            try:
                if self.inflight.get(message_id) is item:
                    del self.inflight[message_id]
            finally:
                if self.state_lock:
                    self.state_lock.release()

    def _handle_property_set(self, message):
        params = message.get("params", {})
        if not isinstance(params, dict):
            params = {}
        if "product_information:SendCommand" in params or "SendCommand" in params:
            self.logger.runtime(
                "command", "collector", "SendCommand", "ignore", "cloud",
                "Reserved SendCommand received; no business action is configured"
            )
        reply = {
            "id": str(message.get("id", "0")),
            "code": 200,
            "data": {},
            "message": "success",
            "method": "thing.service.property.set_reply",
            "version": "1.0",
        }
        self.publish_raw(self.topics["property_set_reply"], json.dumps(reply), 0)

    def _handle_ota_json(self, message):
        if not self.ota:
            return
        code = str(message.get("code", ""))
        if code and code not in ("0", "200", "1000"):
            return
        data = message.get("data", {})
        if isinstance(data, dict) and data:
            self.ota.enqueue(data)

    def _message_callback(self, topic, payload):
        topic_text = topic.decode() if isinstance(topic, bytes) else str(topic)
        if topic_text == self.topics["ota_file_reply"]:
            if self.ota:
                self.ota.handle_file_reply(payload)
            return
        try:
            text = payload.decode() if isinstance(payload, bytes) else payload
            message = json.loads(text)
        except Exception:
            self.logger.warn("mqtt", "JSON", "Invalid JSON from {}".format(topic_text))
            return
        if topic_text == self.topics["property_post_reply"]:
            self._handle_property_reply(message)
        elif topic_text == self.topics["property_set"]:
            self._handle_property_set(message)
        elif topic_text in (self.topics["ota_upgrade"], self.topics["ota_get_reply"]):
            self._handle_ota_json(message)

    def stats(self):
        if self.state_lock:
            self.state_lock.acquire()
        try:
            inflight = len(self.inflight)
        finally:
            if self.state_lock:
                self.state_lock.release()
        if self.deferred_lock:
            self.deferred_lock.acquire()
        try:
            deferred = len(self.deferred_properties)
            deferred_dropped = self.deferred_dropped
        finally:
            if self.deferred_lock:
                self.deferred_lock.release()
        return {
            "mqtt_state": self.mqtt_state,
            "net_state": self.net_state,
            "inflight": inflight,
            "retry_count": self.retry_count,
            "post_reply_success": self.post_reply_success,
            "post_reply_rejected": self.post_reply_rejected,
            "post_reply_unmatched": self.post_reply_unmatched,
            "last_post_reply_code": self.last_post_reply_code,
            "deferred": deferred,
            "deferred_dropped": deferred_dropped,
        }
